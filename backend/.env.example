# Copia este archivo a .env y rellena los valores reales.

# Puerto y entorno
PORT=3001
SESSION_TTL_HOURS=24

# Google Drive (respaldos en la nube) — cliente OAuth tipo "Aplicación web"
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: si se omite se usa <origen de la petición>/api/admin/backup/oauth2callback.
# Debe coincidir exactamente con un "URI de redireccionamiento autorizado" en Google Cloud.
# GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/admin/backup/oauth2callback
# Detrás de un proxy HTTPS (Nginx, Render, Railway...) activa esto para que el origen sea https://
# TRUST_PROXY=true

# Vincular dispositivos (conexión por internet). La app de escritorio lo configura sola;
# en desarrollo apunta al cloudflared incluido en electron/bin.
# CLOUDFLARED_PATH=C:/ruta/a/superShop/electron/bin/cloudflared.exe
